# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Leave MONGODB_URI empty or commented out to automatically use the built-in in-memory MongoDB
# Or provide your MongoDB connection string (e.g., local mongod or MongoDB Atlas)
# MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_payment_db

# Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Reservation Expiration in Minutes (default: 10 minutes)
RESERVATION_EXPIRY_MINUTES=10
