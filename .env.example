PORT=3000
NODE_ENV=development

# true = embedded MongoDB replica set (no Docker, no Atlas).
USE_IN_MEMORY_MONGO=true

# Used when USE_IN_MEMORY_MONGO is not true. Must be a replica set (Atlas or local).
MONGODB_URI=mongodb://127.0.0.1:27017/pos_system?replicaSet=rs0

# How long a Pending order may hold reserved stock before it expires.
RESERVATION_TTL_MS=300000

# How often the background job scans for expired reservations.
EXPIRY_JOB_INTERVAL_MS=10000
